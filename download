def sprawdz_czy_przetworzony(nazwa_skladnika):
    """Sprawdza czy produkt to przetworzone mięso (ZAKAZ od 2026)"""
    t = nazwa_skladnika.lower()
    for zakaz in KATEGORIE_SKLADNIKOW["mieso_przetworzane_ZAKAZ"]:
        if zakaz in t:
            return True
    return False

def sprawdz_czy_swiezy_mieso(nazwa_skladnika):
    """Sprawdza czy to świeże mięso (WYMAGANE od 2026)"""
    t = nazwa_skladnika.lower()
    zwroty_swieze = ["świeże", "świeży", "naturalny", "mielone (świeże)"]
    for zwrot in zwroty_swieze:
        if zwrot in t:
            return True
    if not sprawdz_czy_przetworzony(t):
        for mieso in KATEGORIE_SKLADNIKOW["mieso_swieze"]:
            if mieso in t and not sprawdz_czy_przetworzony(t):
                return True
    return False

def sprawdz_wymogi_2026(nazwa_dania, skladniki, typ_dania):
    """Sprawdzenie zgodności z Rozp. MZ 2026"""
    niezgodnosci = []
    tekst = f"{nazwa_dania} {' '.join(s['nazwa_skladnika'] for s in skladniki)}".lower()
    
    ma_warzywa = any(any(w in tekst for w in KATEGORIE_SKLADNIKOW["warzywo"]) 
                     for s in skladniki)
    if not ma_warzywa:
        niezgodnosci.append("Brak warzyw (WYMAGANE!)")
    
    ilosc_warzyw = sum(1 for s in skladniki 
                       if any(w in s["nazwa_skladnika"].lower() 
                              for w in KATEGORIE_SKLADNIKOW["warzywo"]))
    ilosc_owocow = sum(1 for s in skladniki 
                       if any(o in s["nazwa_skladnika"].lower() 
                              for o in KATEGORIE_SKLADNIKOW["owoc"]))
    if ilosc_owocow > 0 and ilosc_warzyw <= ilosc_owocow:
        niezgodnosci.append("Owoce muszą być mniejszością niż warzywa")
    
    for skladnik in skladniki:
        if sprawdz_czy_przetworzony(skladnik["nazwa_skladnika"]):
            niezgodnosci.append(f"ZAKAZ: '{skladnik['nazwa_skladnika']}' to mięso przetworzane!")
    
    ma_mieso = any(any(m in s["nazwa_skladnika"].lower() 
                       for m in KATEGORIE_SKLADNIKOW["mieso_swieze"]) 
                   for s in skladniki)
    if ma_mieso:
        swiezy = any(sprawdz_czy_swiezy_mieso(s["nazwa_skladnika"]) 
                    for s in skladniki)
        if not swiezy and not any(sprawdz_czy_przetworzony(s["nazwa_skladnika"]) 
                                  for s in skladniki):
            niezgodnosci.append("Jeśli mięso - musi być ŚWIEŻE (nie może być garmażeryjne)")
    
    if typ_dania == "zupa":
        ma_wywar_warz = any(any(w in s["nazwa_skladnika"].lower() 
                               for w in KATEGORIE_SKLADNIKOW["wywar_warzywny"]) 
                           for s in skladniki)
        ma_wywar_mies = any(any(w in s["nazwa_skladnika"].lower() 
                               for w in KATEGORIE_SKLADNIKOW["wywar_mieso_ZAKAZ"]) 
                           for s in skladniki)
        if not ma_wywar_warz and ma_wywar_mies:
            niezgodnosci.append("ZUPA: Musi być na wywarze warzywnym, nie mięsnym!")
    
    return {
        "zgodny": len(niezgodnosci) == 0,
        "niezgodnosci": niezgodnosci
    }

